{
  "1": {
    "class_type": "LoadAudio",
    "inputs": { "audio": "speech_female_short.wav" },
    "_meta": { "title": "reference voice" }
  },
  "2": {
    "class_type": "CharacterVoicesNode",
    "inputs": {
      "voice_name": "none",
      "reference_text": "",
      "trim_start": 0.0,
      "trim_end": 0.0,
      "customized": false,
      "opt_audio_input": ["1", 0]
    },
    "_meta": { "title": "use the reference clip as the voice" }
  },
  "3": {
    "class_type": "VibeVoiceEngineNode",
    "inputs": {
      "model": "vibevoice-1.5B",
      "device": "auto",
      "quantize_llm_4bit": false,
      "attention_mode": "auto",
      "multi_speaker_mode": "Custom Character Switching",
      "cfg_scale": 3.0,
      "inference_steps": 3,
      "use_sampling": false,
      "temperature": 0.95,
      "top_p": 0.95,
      "chunk_minutes": 0,
      "max_new_tokens": 0
    },
    "_meta": { "title": "VibeVoice engine (expressive, long-form)" }
  },
  "4": {
    "class_type": "UnifiedTTSTextNode",
    "inputs": {
      "TTS_engine": ["3", 0],
      "text": "I wasn't expecting anyone tonight. But since you're here, sit down. Let me tell you what really happened at the harbor.",
      "narrator_voice": "none",
      "seed": 1,
      "opt_narrator": ["2", 0],
      "enable_chunking": true,
      "max_chars_per_chunk": 400,
      "chunk_combination_method": "auto",
      "silence_between_chunks_ms": 100,
      "enable_audio_cache": true,
      "batch_size": 0
    },
    "_meta": { "title": "text to speak" }
  },
  "5": {
    "class_type": "SaveAudio",
    "inputs": { "audio": ["4", 0], "filename_prefix": "voices/expressive" },
    "_meta": { "title": "save" }
  }
}
