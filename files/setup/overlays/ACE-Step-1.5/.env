# Local settings for this install (git-ignored, survives updates).
# Written for a 16 GB graphics card. The launchers in the kit's launchers folder
# pass the model on the command line, which takes priority over this file;
# these values apply when ACE-Step is started some other way (e.g. the API).
# CPU offload, 8-bit quantization and the LM backend are auto-detected.

# Music model. Downloaded: acestep-v15-xl-turbo (4B, best sound),
# acestep-v15-turbo (2B, faster) and acestep-v15-base (2B, slower, needed for
# the extract / lego / complete modes). The 2B turbo is the default here
# because XL on 16 GB also needs --offload_dit_to_cpu true, which only the
# "ACE-Step (music).bat" launcher passes.
ACESTEP_CONFIG_PATH=acestep-v15-turbo

# "Thinking" planner. 1.7B is the largest ACE-Step allows on a 16 GB card
# (the 4B planner needs about 12 GB on its own).
ACESTEP_LM_MODEL_PATH=acestep-5Hz-lm-1.7B
ACESTEP_INIT_LLM=auto
